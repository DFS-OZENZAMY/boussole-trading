{
  // Configuration Cloudflare Workers de Boussole Trading
  "name": "boussole-trading",
  "main": "src/worker.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Toutes les requêtes passent d'abord par le Worker, qui vérifie la connexion
    "run_worker_first": true
  },

  // Base de données D1 des comptes, des données et des journaux des traders
  "d1_databases": [
    { "binding": "DB", "database_name": "bossole_trading", "database_id": "626fcd49-7d55-4cf4-99ce-4cd2afea2911" }
  ],

  "observability": { "enabled": true }
}
